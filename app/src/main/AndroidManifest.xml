<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Firebase. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: lets the sync foreground-service notification show. Asked during onboarding. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional floating chat bubble over the movie. Special access, user-granted in settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Package visibility (Android 11+) for the room's "Play in …" button and friends' "Open in …"
         buttons. Keep in sync with StreamingConfig / ActivityApp. -->
    <queries>
        <package android:name="com.netflix.mediaclient" />
        <package android:name="in.startv.hotstar" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.amazon.mp3" />
    </queries>

    <application
        android:name=".SyncItApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SyncIt">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Invite links: https://syncit-watchparty.web.app/join/ABC123 open straight in the app
                 once Android verifies web/.well-known/assetlinks.json (see RoomLinks.WEB_HOST). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="syncit-watchparty.web.app" android:pathPrefix="/join/" />
            </intent-filter>
            <!-- Passwordless email sign-in. THE ONE PLACE the email-link host/path live in the app.
                 Firebase's default handler: https://syncit-watchparty.firebaseapp.com/__/auth/action?mode=signIn&oobCode=…
                 (web.app can't be an email-link domain: INVALID_HOSTING_LINK_DOMAIN). Must match
                 FirebaseAuthService.EMAIL_LINK_DOMAIN / EMAIL_LINK_PATH_PREFIX in :data-firebase. That
                 host serves its own assetlinks.json. MainActivity hands the whole URL to
                 AuthService.isEmailSignInLink / completeEmailLinkSignIn. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="syncit-watchparty.firebaseapp.com" android:pathPrefix="/__/auth/" />
            </intent-filter>
            <!-- Older invites and the "Open in app" button on the invite page: syncit://join/ABC123 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="syncit" android:host="join" />
            </intent-filter>
        </activity>

        <service
            android:name=".overlay.ChatBubbleService"
            android:exported="false" />

        <!-- Push notifications for messages and friend requests (sent by push-relay/ via FCM). -->
        <service
            android:name=".push.VyroMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_vyro" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="messages" />
    </application>
</manifest>
