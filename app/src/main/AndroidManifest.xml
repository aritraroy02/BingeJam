<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Firebase. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: lets the sync foreground-service notification show. Asked during onboarding. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional floating chat bubble over the movie. Special access, user-granted in settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".SyncItApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Room invite links: syncit://join/ABC123 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="syncit" android:host="join" />
            </intent-filter>
        </activity>

        <service
            android:name=".overlay.ChatBubbleService"
            android:exported="false" />
    </application>
</manifest>
