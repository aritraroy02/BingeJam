<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Foreground service that keeps the MediaController and room connection alive while in a room. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application>
        <!--
            Exists only so the user can grant Notification Access, which is what Android requires
            before MediaSessionManager.getActiveSessions() will return other apps' sessions.
            It never reads notification content. No android:label, so Settings shows the app's own
            name (app_name in :app; the brand lives in one place, see core/config/Brand.kt).
        -->
        <service
            android:name="com.syncit.media.MediaListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name="com.syncit.media.service.SyncForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
