{
  "name": "bingejam-desktop",
  "productName": "BingeJam",
  "version": "0.1.0",
  "private": true,
  "description": "BingeJam for Windows: watch and listen together, in sync.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build",
    "preview": "node scripts/run.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test --experimental-strip-types \"src/shared/**/*.test.ts\"",
    "firebase-config": "node scripts/firebase-config.mjs"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "typescript": "5.9",
    "vite": "^8.3.6"
  }
}
